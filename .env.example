# Demo_00 — Device Query Tool configuration
#
# Shared credentials (SmartCabinet) are loaded from ../.env.vendera automatically.
# Azure AD credentials are loaded from ../.env.azure if present.
# Override any variable below by setting it in your .env file.

# --- Device Info (vendera.ai IoT platform) ---
DEVICE_INFO_LOGIN_URL=https://iot-usa.vendera.ai/iot/user/login
DEVICE_INFO_USER=
DEVICE_INFO_PWD=

# --- InHand Device Manager ---
DM_BASE_URL=https://iot.inhandnetworks.com
DM_CLIENT_ID=
DM_CLIENT_SECRET=
DM_USERNAME=
DM_PASSWORD=

# --- Hologram SIM/cellular ---
HOLOGRAM_API_KEY=
HOLOGRAM_BASE_URL=https://dashboard.hologram.io/api/1
HOLOGRAM_ORG_ID=

# --- Hongdian router northbound API ---
HONGDIAN_BASE_URL=https://sandora.hongdian.com
HONGDIAN_TOKEN=

# --- JC 4G Module (built-in main controller) ---
# Queries vendera.ai IoT for 4G network metrics. Reuses DEVICE_INFO_USER/DEVICE_INFO_PWD above.
# JC_MODULE_LOG_URL=https://iot-usa.vendera.ai/iot/machine/logs/network/status
