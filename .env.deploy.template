# =============================================================================
# IoT Device Query Backend — Environment Variables Template
# =============================================================================
# Copy this file to .env.deploy, fill in values, then:
#   docker compose up -d --build
#
# The backend will be available at http://<host>:8000
# Health check: GET /health
# Query API:    POST /api/query
# =============================================================================

# ---- vendera.ai IoT (Device Info) ----
# Octopus-Token based auth for fetching device basic/operating info
DEVICE_INFO_USER=
DEVICE_INFO_PWD=

# ---- SmartCabinet / Router Code ----
# Bearer Token + RSA+AES encrypted login for device↔router SN lookup
SMARTCABINET_CLIENT_ID=
SMARTCABINET_TENANT_ID=
SMARTCABINET_PUB_KEY=
SMARTCABINET_USER=
SMARTCABINET_PWD=

# ---- InHand Device Manager ----
# OAuth2 password-grant auth. Prefix RF* routers are queried here
DM_CLIENT_ID=
DM_CLIENT_SECRET=
DM_USERNAME=
DM_PASSWORD=

# ---- Hologram Cellular ----
# API key auth for SIM status, data plan, session info
HOLOGRAM_API_KEY=
HOLOGRAM_ORG_ID=

# ---- Hongdian Northbound API ----
# Bearer token auth. Non-RF/non-JC-prefix routers are queried here
HONGDIAN_TOKEN=

# ---- JC 4G Module (built-in main controller) ----
# Queries vendera.ai IoT for 4G network metrics.
# Reuses DEVICE_INFO_USER/DEVICE_INFO_PWD above (Octopus-Token auth).
# JC_MODULE_LOG_URL=https://iot-usa.vendera.ai/iot/machine/logs/network/status
